    <record id="action_ming_customer_list" model="ir.actions.act_window">
        <field name="name">Khách hàng</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_res_partner_ming_customer_search"/>
        <field name="domain">['|', ('ming_pos_customer_code', '!=', False), '&amp;', ('ming_source_system', '!=', False), ('ming_branch_id', '!=', False)]</field>
        <field name="context">{'search_default_filter_ming_customers': 1, 'create': False}</field>
    </record>

    <record id="action_ming_vip_risk_customers" model="ir.actions.act_window">
        <field name="name">Khách VIP có nguy cơ</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_res_partner_ming_customer_search"/>
        <field name="domain">['&amp;', ('ming_is_vip', '=', True), '&amp;', ('ming_activity_status', '=', 'at_risk'), '|', ('ming_pos_customer_code', '!=', False), '&amp;', ('ming_source_system', '!=', False), ('ming_branch_id', '!=', False)]</field>
        <field name="context">{'search_default_filter_vip_risk': 1, 'create': False}</field>
    </record>

    <record id="action_ming_returned_customers" model="ir.actions.act_window">
        <field name="name">Khách hàng đã quay lại</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_res_partner_ming_customer_search"/>
        <field name="domain">['&amp;', ('ming_has_returned', '=', True), '|', ('ming_pos_customer_code', '!=', False), '&amp;', ('ming_source_system', '!=', False), ('ming_branch_id', '!=', False)]</field>
        <field name="context">{'search_default_filter_returned': 1, 'create': False}</field>
    </record>

    <record id="action_ming_customer_list_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_res_partner_ming_customer_list"/>
        <field name="act_window_id" ref="action_ming_customer_list"/>
    </record>

    <record id="action_ming_customer_list_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_res_partner_ming_customer_form"/>
        <field name="act_window_id" ref="action_ming_customer_list"/>
    </record>

    <record id="action_ming_vip_risk_customers_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_res_partner_ming_customer_list"/>
        <field name="act_window_id" ref="action_ming_vip_risk_customers"/>
    </record>

    <record id="action_ming_vip_risk_customers_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_res_partner_ming_customer_form"/>
        <field name="act_window_id" ref="action_ming_vip_risk_customers"/>
    </record>

    <record id="action_ming_returned_customers_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_res_partner_ming_customer_list"/>
        <field name="act_window_id" ref="action_ming_returned_customers"/>
